<Project Sdk="Microsoft.NET.Sdk">
  <!-- Reference-only stand-in for UnityEngine.dll (see UnityEngine.cs). Never ship this assembly. -->
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>UnityEngine</AssemblyName>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <FileVersion>0.0.0.0</FileVersion>
    <LangVersion>7.3</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CS0660;CS0661</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net35" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
